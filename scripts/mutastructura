# GNU Affero General Public License for more details.

# You should have received a copy of the GNU Affero General Public License
# along with mutastructura. If not, see <https://www.gnu.org/licenses/>.

# Commentary:
#
# This bash script provides a convenient and user-friendly wrapper
# around the command-line usage of `mutastructura`, allowing the
# Guile Scheme application to behave and feel like any other
# executable or binary that users may install to their systems.
#
# This also helps installing `mutastructura` in a convenient fashion
# to the Guix store and it allows us to decouple the user-facing
# command-line interface from the internal Guile Scheme arguments
# to the main program and library.
#
# Some of the rationale behind the `SCRIPT_DIR` and `STORE_DIR`
# can be explained due to the need of reliably and reproducibly
# deploying source code and other resources to the Guix store
# and have access to those at runtime.

set -euo pipefail

script_dir=$(dirname "$0")
store_dir=$(readlink -f "$script_dir/..")
scheme_sources_dir="${store_dir}/share/guile/site/3.0"
resources_dir="${store_dir}/share/resources"
scripts_dir="${store_dir}/share/scripts"

red_text='\033[0;31m'
reset_text='\033[0m'

log_error() {
  if [ -z "${1}" ]; then
    log_error "log_error was called without a message!"
    return 1
  fi

  echo -e "${red_text}[error] $1${reset_text}" >&2
}

log_info() {
  if [ -z "${1}" ]; then
    log_error "log_info was called without a message!"
    return 1
  fi

  echo -e "$1"
}

show_help() {
  cat "${resources_dir}/help.txt"
}

# The command is the first word: `mutastructura status -m ./migrations ...'.
# Anything else is an option, and no word at all means `migrate', which is what
# this program did before it had more than one thing to do.
command_name="migrate"

case "${1:-}" in
  migrate | status | clean)
    command_name="${1}"
    shift
    ;;
  help | --help | -h)
    show_help
    exit 0
    ;;
  "" | -*) ;;
  *)
    # A word that is not a command and not an option.  Saying so beats
    # migrating anyway because a typo happened to look like a file name.
    log_error "unknown command '${1}'"
    show_help
    exit 1
    ;;
esac

parsed_options=$(getopt -n "mutastructura" -o m:d:c:r:hv \
  --long migrations:,database:,connection:,resources:,placeholder:,help,dry-run,verbose \
  -- "$@")

eval set -- "${parsed_options}"

resources_arg="${resources_dir}"
placeholder_args=()

guile_cmd_args=(
  "-L" "${scheme_sources_dir}"
  "-c" "((@(mutastructura main) main))"
  "--command" "${command_name}"
)

while true; do
  case "${1}" in
  -m | --migrations)
    migrations_arg="${2}"
    guile_cmd_args+=("--migrations" "$(realpath "${migrations_arg}")")
    shift 2
    ;;
  -c | --connection)
    connection_arg="${2}"
    guile_cmd_args+=("--connection" "${connection_arg}")
    shift 2
    ;;
  -d | --database)
    database_arg="${2}"
    guile_cmd_args+=("--database" "${database_arg}")
    shift 2
    ;;
  -r | --resources)
    resources="${2}"
    if [[ -n "${resources}" ]]; then
      resources_arg="${resources}"
      shift 2
    fi
    ;;
  --placeholder)
    # Repeated --placeholder flags are collected into the one value the Guile
    # side reads, comma-separated, which is the form its parser already knows.
    placeholder_args+=("${2}")
    shift 2
    ;;
  --dry-run)
    guile_cmd_args+=("--dry-run")
    shift
    ;;
  -v | --verbose)
    guile_cmd_args+=("--verbose")
    shift
    ;;
  -h | --help)
    show_help
    exit 0
    ;;
  --)
    shift
    break
    ;;
  *)
    log_error "Internal error: unrecognized option '${1}'"
    show_help
    exit 1
    ;;
  esac
done

# Anything left over is not an option this program knows and was not consumed as
# one: it is a word nobody asked for, and running anyway would be guessing.
if [ "${#}" -gt 0 ]; then
  log_error "unexpected argument '${1}'"
  show_help
  exit 1
fi

# The placeholders, as the one comma-separated value the Guile side parses.
if [ "${#placeholder_args[@]}" -gt 0 ]; then
  joined_placeholders=$(
    IFS=,
    echo "${placeholder_args[*]}"
  )
  guile_cmd_args+=("--placeholder" "${joined_placeholders}")
fi

# The resources
guile_cmd_args+=("--resources" "${resources_arg}")

log_info "-------------------------------------------------"
log_info "Starting Mutastructura: guile ${guile_cmd_args[*]}"

# Run Guile application
exec guile "${guile_cmd_args[@]}"
