#
# Generated by gen_containers.py; keep in step with packaging/.

FROM opensuse/tumbleweed:latest AS builder

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile guile-devel gcc make autoconf automake libtool \
        pkg-config gawk gnulib-devel gettext-tools findutils \
        libcurl-devel sqlite3-devel guile-json guile-gcrypt \
        guile-fibers tar gzip; \
    zypper clean --all

# Build the Guile libraries openSUSE does not package.  They are
# copied into the runtime with the project, so the image needs no
# extra repository or post-install step.

ADD https://github.com/opencog/guile-dbi/archive/refs/tags/guile-dbi-3.2.0.tar.gz /tmp/guile-dbi.tar.gz
RUN set -eu; \
    mkdir -p "/tmp/guile-dbi"; \
    tar xzf "/tmp/guile-dbi.tar.gz" -C "/tmp/guile-dbi" --strip-components=1; \
    cd "/tmp/guile-dbi/guile-dbi"; \
    ./autogen.sh; \
    ./configure --prefix=/usr --libdir=/usr/lib64; \
    make -j"$(nproc)"; \
    make install; \
    cd "../guile-dbd-sqlite3"; \
    ./autogen.sh; \
    ./configure --prefix=/usr --libdir=/usr/lib64; \
    make -j"$(nproc)"; \
    make install

COPY src/mutastructura ./src/mutastructura
COPY scripts/mutastructura ./scripts/mutastructura
COPY resources ./resources

RUN set -eu; \
    site="/usr/share/guile/site/3.0"; \
    install -d "$site/mutastructura"; \
    cp -r "src/mutastructura/." "$site/mutastructura/"; \
    install -D -m 0755 "scripts/mutastructura" "/usr/bin/mutastructura"; \
    sed -i '1s|^#!/usr/bin/env \(.*\)$|#!/usr/bin/\1|' "/usr/bin/mutastructura"; \
    sed -i 's|share/resources|share/mutastructura/resources|g' "/usr/bin/mutastructura"; \
    install -d "/usr/share/mutastructura/resources"; \
    cp -r resources/. "/usr/share/mutastructura/resources/"

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------

FROM opensuse/tumbleweed:latest AS runtime

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="mutastructura" \
      org.opencontainers.image.description="Relational database schema migrations in Guile Scheme" \
      org.opencontainers.image.url="https://codeberg.org/jjba23/mutastructura" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}"

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile \
        ca-certificates \
        guile-gcrypt \
        libsqlite3-0 \
        libltdl7 \
        bash \
        coreutils; \
    zypper clean --all

COPY --from=builder /usr/share/guile/site /usr/share/guile/site
COPY --from=builder /usr/lib64/guile /usr/lib64/guile
COPY --from=builder /usr/lib64/libguile-dbi.so* /usr/lib64/
COPY --from=builder /usr/lib64/libguile-dbd-sqlite3.so* /usr/lib64/
RUN ldconfig
COPY --from=builder /usr/bin/mutastructura /usr/bin/mutastructura
COPY --from=builder /usr/share/mutastructura /usr/share/mutastructura

ENTRYPOINT ["/usr/bin/mutastructura"]
